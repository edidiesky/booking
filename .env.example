NODE_ENV=NODE_ENV
PORT=4000
API_INTERNAL_URL=http://booking:4000/api/v1
# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRES_DB
DATABASE_URL=postgresql://postgres:POSTGRES_DB@pgbouncer:6432/booking_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_PASSWORD

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=ELASTICSEARCH_PASSWORD


CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET

PGA_API_KEY=PGA_API_KEY

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# JWT
JWT_SECRET=JWT_SECRET

# Paystack
PAYSTACK_SECRET_KEY=PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=PAYSTACK_WEBHOOK_SECRET

# Flutterwave
FLW_SECRET_KEY=FLW_SECRET_KEY
FLW_WEBHOOK_SECRET=FLW_WEBHOOK_SECRET

# App
WEB_ORIGIN=http://localhost:5173
BASE_DOMAIN=localhost:4000

# OTel
OTEL_SERVICE_NAME=booking-platform
OTEL_ENABLED=true
TEMPO_URL=http://tempo:4318/v1/traces

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GRAFANA_ADMIN_PASSWORD

# Outbox
OUTBOX_POLL_INTERVAL_MS=5000
INTERNAL_SECRET=INTERNAL_SECRET

RESEND_API_KEY=RESEND_API_KEY
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Acme
EMAIL_PROVIDER=resend



GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback