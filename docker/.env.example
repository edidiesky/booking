# Copy to docker/.env and fill values. Never commit docker/.env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdev_change_me
POSTGRES_DB=ledger_service

RABBITMQ_USER=booking
RABBITMQ_PASSWORD=localdev_rabbit_change_me

# Optional gateway keys (not required for boot)
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=

FLW_SECRET_HASH=
SAGA_PAUSE_TIMEOUT_MS=1800000
SAGA_SWEEP_INTERVAL_MS=30000

LOG_LEVEL=info
