{
  "name": "@booking/service-decomposition-poc",
  "private": true,
  "workspaces": [
    "packages/shared",
    "booking-service",
    "payment-service",
    "ledger-service",
    "orchestration-service",
    "notification-worker"
  ],
  "scripts": {
    "build:shared": "npm run build -w @booking/shared",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "docker:up": "docker compose --env-file docker/.env -f docker/docker-compose.services.yml up -d --build",
    "docker:down": "docker compose --env-file docker/.env -f docker/docker-compose.services.yml down",
    "docker:logs": "docker compose --env-file docker/.env -f docker/docker-compose.services.yml logs -f --tail=100"
  }
}
